{
  "name": "trefoil",
  "version": "1.0.1",
  "description": "Trefoil — 思考的可视化工作台：精确几何绘图 + 结构化思维导图容器 + 积木式交互 + 镭射笔演示标注（Obsidian 白板插件）",
  "main": "dist/main.js",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "canvas",
    "whiteboard",
    "mindmap",
    "konva"
  ],
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "obsidian": "^1.8.7",
    "svelte": "^5.36.0",
    "svelte-check": "^4.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "konva": "^9.3.20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
